[Unit]
Description=BOTC public image export proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/botc-image-proxy/botc-image-proxy
Restart=on-failure
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M

[Install]
WantedBy=multi-user.target
